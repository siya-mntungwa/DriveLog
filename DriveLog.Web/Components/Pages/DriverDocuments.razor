@page "/driver/documents"

@rendermode InteractiveServer

@using DriveLog.Web.Services

@inject DriveLogApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>My Documents</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="mb-0">My Documents</h1>

    <a href="/driver" class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

@if (documents == null)
{
    <p>Loading documents...</p>
}
else if (documents.Count == 0)
{
    <div class="alert alert-info">
        No documents found.
    </div>
}
else
{
    <div class="d-flex flex-column gap-2">

        @foreach (var document in documents)
        {
            <div class="card">

                <button type="button"
                        class="btn w-100 text-start d-flex justify-content-between align-items-center"
                        @onclick="() => ToggleDocument(document.Id)">

                    <div>
                        <strong>@document.DocumentType</strong>

                        <span class="ms-2">

                            @if (document.DocumentStatus == "Approved")
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else if (document.DocumentStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @document.DocumentStatus
                                </span>
                            }

                        </span>
                    </div>

                    <span>
                        @(expandedDocumentId == document.Id ? "▲" : "▼")
                    </span>

                </button>

                @if (expandedDocumentId == document.Id)
                {
                    <div class="border-top p-3">

                        <div class="row g-3">

                            <div class="col-md-4">
                                <strong>Document</strong>
                                <div>@document.DocumentType</div>
                            </div>

                            <div class="col-md-4">
                                <strong>File</strong>
                                <div>@document.FileName</div>
                            </div>

                            <div class="col-md-4">
                                <strong>Status</strong>

                                <div>
                                    @if (document.DocumentStatus == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (document.DocumentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @document.DocumentStatus
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="col-md-4">
                                <strong>Issue Date</strong>

                                <div>
                                    @document.IssueDate.ToShortDateString()
                                </div>
                            </div>

                            <div class="col-md-4">
                                <strong>Expiry Date</strong>

                                <div>
                                    @document.ExpiryDate.ToShortDateString()
                                </div>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>
}

@code {

    private List<DriverDocumentDto>? documents;

    private int? expandedDocumentId;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn || !AuthService.IsDriver)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var userId = AuthService.CurrentUser!.UserId;

        documents = await ApiService.GetDriverDocumentsAsync(userId);
    }

    private void ToggleDocument(int documentId)
    {
        if (expandedDocumentId == documentId)
            expandedDocumentId = null;
        else
            expandedDocumentId = documentId;
    }
}