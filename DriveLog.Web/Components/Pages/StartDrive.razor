@page "/driver/start-drive"

@rendermode InteractiveServer

@using DriveLog.Web.Services

@inject DriveLogApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Start Drive</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <a href="/driver" class="btn btn-secondary">
        ← Back to Dashboard
    </a>

    <h1 class="mb-0">Start Drive</h1>

    <div style="width: 150px;"></div>

</div>

@if (vehicles == null)
{
    <p>Loading vehicles...</p>
}
else
{
    <div class="card">
        <div class="card-body">

            <EditForm Model="driveRequest"
                      OnValidSubmit="HandleStartDrive"
                      FormName="StartDriveForm">

                <DataAnnotationsValidator />

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Vehicle
                        </label>

                        <select class="form-select"
                                @bind="driveRequest.VehicleId">

                            <option value="0">
                                Select vehicle
                            </option>

                            @foreach (var vehicle in vehicles.Where(v => v.Status == 0))
                            {
                                <option value="@vehicle.Id">
                                    @vehicle.RegistrationNumber -
                                    @vehicle.Make @vehicle.Model
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Customer
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="driveRequest.Customer" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Delivery Note ID
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="driveRequest.DeliveryNoteId" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Start KM
                        </label>

                        <input class="form-control"
                               value="@GetSelectedVehicleKm()"
                               readonly />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Start Location
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="driveRequest.StartLocation" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Purpose
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="driveRequest.Purpose" />

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary">

                    Start Drive

                </button>

            </EditForm>

        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info mt-3">
            @message
        </div>
    }
}

@code {

    private List<VehicleDto>? vehicles;

    private StartDriveRequest driveRequest = new();

    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn || !AuthService.IsDriver)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        driveRequest.UserId = AuthService.CurrentUser!.UserId;

        vehicles = await ApiService.GetVehiclesAsync();
    }

    private async Task HandleStartDrive()
    {
        var result = await ApiService.StartDriveAsync(driveRequest);

        if (result == null)
        {
            message = "Unable to start the drive.";
            return;
        }

        Navigation.NavigateTo("/driver/drive");
    }

    private string GetSelectedVehicleKm()
    {
        if (driveRequest.VehicleId == 0)
            return string.Empty;

        var vehicle = vehicles?.FirstOrDefault(
            v => v.Id == driveRequest.VehicleId);

        return vehicle?.CurrentKm.ToString("N0") ?? string.Empty;
    }
}