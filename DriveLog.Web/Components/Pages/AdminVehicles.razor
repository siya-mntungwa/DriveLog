
@page "/admin/vehicles"

@rendermode InteractiveServer

@using DriveLog.Web.Services

@inject DriveLogApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Admin - Vehicles</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Vehicles</h1>

    <a href="/admin" class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>

@if (vehicles == null)
{
    <p>Loading vehicles...</p>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Add Vehicle</h5>

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Registration Number</label>
                    <InputText class="form-control"
                               @bind-Value="newVehicle.RegistrationNumber" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Make</label>
                    <InputText class="form-control"
                               @bind-Value="newVehicle.Make" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Model</label>
                    <InputText class="form-control"
                               @bind-Value="newVehicle.Model" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Year</label>
                    <InputNumber class="form-control"
                                 @bind-Value="newVehicle.Year" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-info mt-3">
                    @message
                </div>
            }

            <button class="btn btn-primary mt-3"
                    @onclick="AddVehicle">
                Add Vehicle
            </button>
        </div>
    </div>

    @if (isEditing)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Edit Vehicle</h5>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Registration Number</label>
                        <InputText class="form-control"
                                   @bind-Value="editVehicle.RegistrationNumber" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Make</label>
                        <InputText class="form-control"
                                   @bind-Value="editVehicle.Make" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Model</label>
                        <InputText class="form-control"
                                   @bind-Value="editVehicle.Model" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Year</label>
                        <InputNumber class="form-control"
                                     @bind-Value="editVehicle.Year" />
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary me-2"
                            @onclick="SaveVehicle">
                        Save Changes
                    </button>

                    <button class="btn btn-outline-secondary"
                            @onclick="CancelEditing">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }

    @if (vehicles.Count == 0)
    {
        <div class="alert alert-info">
            No vehicles found.
        </div>
    }
    else
    {
        <h5 class="mb-3">Vehicles</h5>

        <div class="list-group">

            @foreach (var vehicle in vehicles)
            {
                <div class="border rounded mb-2">

                    <button type="button"
                            class="btn w-100 text-start d-flex justify-content-between align-items-center"
                            @onclick="() => ToggleVehicle(vehicle.Id)">

                        <span>
                            <strong>@vehicle.RegistrationNumber</strong>
                            — @vehicle.Make @vehicle.Model

                            <span class="ms-2">
                                @switch (vehicle.Status)
                                {
                                    case 0:
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                        break;

                                    case 1:
                                        <span class="badge bg-warning text-dark">
                                            In Use
                                        </span>
                                        break;

                                    case 2:
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                        break;

                                    default:
                                        <span class="badge bg-dark">
                                            Unknown
                                        </span>
                                        break;
                                }
                            </span>
                        </span>

                        <span>
                            @(expandedVehicleId == vehicle.Id ? "▲" : "▼")
                        </span>

                    </button>

                    @if (expandedVehicleId == vehicle.Id)
                    {
                        <div class="border-top p-3">

                            <div class="row g-3">

                                <div class="col-md-3">
                                    <strong>Registration</strong>
                                    <div>@vehicle.RegistrationNumber</div>
                                </div>

                                <div class="col-md-3">
                                    <strong>Make</strong>
                                    <div>@vehicle.Make</div>
                                </div>

                                <div class="col-md-3">
                                    <strong>Model</strong>
                                    <div>@vehicle.Model</div>
                                </div>

                                <div class="col-md-3">
                                    <strong>Year</strong>
                                    <div>@vehicle.Year</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Status</strong>

                                    <div>
                                        @switch (vehicle.Status)
                                        {
                                            case 0:
                                                <span class="badge bg-success">
                                                    Available
                                                </span>
                                                break;

                                            case 1:
                                                <span class="badge bg-warning text-dark">
                                                    In Use
                                                </span>
                                                break;

                                            case 2:
                                                <span class="badge bg-secondary">
                                                    Inactive
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-dark">
                                                    Unknown
                                                </span>
                                                break;
                                        }
                                    </div>
                                </div>

                            </div>

                            <div class="mt-3">

                                <button class="btn btn-sm btn-primary me-2"
                                        @onclick="() => StartEditing(vehicle)">
                                    Edit
                                </button>

                                @if (vehicle.Status != 2)
                                {
                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => DeactivateVehicle(vehicle.Id)">
                                        Deactivate
                                    </button>
                                }

                                @if (vehicle.Status == 2)
                                {
                                    <button class="btn btn-sm btn-success"
                                            @onclick="() => ReactivateVehicle(vehicle.Id)">
                                        Reactivate
                                    </button>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

        </div>
    }
}

@code {

    private List<VehicleDto>? vehicles;

    private CreateVehicleRequest newVehicle = new();

    private string? message;

    private UpdateVehicleRequest editVehicle = new();

    private int editingVehicleId;

    private bool isEditing;

    private int? expandedVehicleId;


    private void ToggleVehicle(int vehicleId)
    {
        if (expandedVehicleId == vehicleId)
        {
            expandedVehicleId = null;
        }
        else
        {
            expandedVehicleId = vehicleId;
        }
    }


    private async Task AddVehicle()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(newVehicle.RegistrationNumber) ||
            string.IsNullOrWhiteSpace(newVehicle.Make) ||
            string.IsNullOrWhiteSpace(newVehicle.Model))
        {
            message = "Please complete all vehicle fields.";
            return;
        }

        var success = await ApiService.CreateVehicleAsync(newVehicle);

        if (success)
        {
            message = "Vehicle added successfully.";

            newVehicle = new CreateVehicleRequest();

            vehicles = await ApiService.GetVehiclesAsync();
        }
        else
        {
            message = "Failed to add vehicle.";
        }
    }


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn || !AuthService.IsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        vehicles = await ApiService.GetVehiclesAsync();
    }


    private async Task DeactivateVehicle(int vehicleId)
    {
        var success = await ApiService.DeactivateVehicleAsync(vehicleId);

        if (success)
        {
            message = "Vehicle deactivated successfully.";

            vehicles = await ApiService.GetVehiclesAsync();
        }
        else
        {
            message = "Vehicle could not be deactivated.";
        }
    }


    private async Task ReactivateVehicle(int vehicleId)
    {
        var success = await ApiService.ReactivateVehicleAsync(vehicleId);

        if (success)
        {
            message = "Vehicle reactivated successfully.";

            vehicles = await ApiService.GetVehiclesAsync();
        }
        else
        {
            message = "Vehicle could not be reactivated.";
        }
    }


    private void StartEditing(VehicleDto vehicle)
    {
        editingVehicleId = vehicle.Id;

        editVehicle = new UpdateVehicleRequest
        {
            RegistrationNumber = vehicle.RegistrationNumber,
            Make = vehicle.Make,
            Model = vehicle.Model,
            Year = vehicle.Year
        };

        isEditing = true;
        message = null;
    }


    private void CancelEditing()
    {
        isEditing = false;

        editVehicle = new UpdateVehicleRequest();
    }


    private async Task SaveVehicle()
    {
        var success = await ApiService.UpdateVehicleAsync(
            editingVehicleId,
            editVehicle);

        if (success)
        {
            message = "Vehicle updated successfully.";

            isEditing = false;

            vehicles = await ApiService.GetVehiclesAsync();
        }
        else
        {
            message = "Vehicle could not be updated.";
        }
    }
}