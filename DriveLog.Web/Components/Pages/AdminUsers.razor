@page "/admin/users"

@rendermode InteractiveServer

@using DriveLog.Web.Services

@inject DriveLogApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>DriveLog - Users</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">User Management</h1>

    <button class="btn btn-outline-secondary"
            @onclick="GoBack">
        Back to Dashboard
    </button>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">
        @message
    </div>
}

<div class="card mb-4">
    <div class="card-body">

        <h5 class="card-title mb-3">Add User</h5>

        <div class="row g-3">

            <div class="col-md-4">
                <label class="form-label">Employee ID</label>
                <InputText class="form-control"
                           @bind-Value="newUser.EmployeeId" />
            </div>

            <div class="col-md-4">
                <label class="form-label">First Name</label>
                <InputText class="form-control"
                           @bind-Value="newUser.FirstName" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Last Name</label>
                <InputText class="form-control"
                           @bind-Value="newUser.LastName" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Email</label>
                <InputText class="form-control"
                           type="email"
                           @bind-Value="newUser.Email" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Password</label>
                <InputText class="form-control"
                           type="password"
                           @bind-Value="newUser.Password" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Role</label>

                <select class="form-select"
                        @bind="newUser.Role">
                    <option value="1">Driver</option>
                    <option value="0">Admin</option>
                </select>
            </div>

        </div>

        <button class="btn btn-primary mt-3"
                @onclick="AddUser"
                disabled="@isSaving">

            @(isSaving ? "Creating..." : "Create User")

        </button>

    </div>
</div>

@if (users.Count == 0)
{
    <div class="alert alert-info">
        No users found.
    </div>
}
else
{
    <h5 class="mb-3">Users</h5>

    <div class="list-group">

        @foreach (var user in users)
        {
            <div class="border rounded mb-2">

                <button type="button"
                        class="btn w-100 text-start d-flex justify-content-between align-items-center"
                        @onclick="() => ToggleUser(user.Id)">

                    <span>

                        <strong>@user.EmployeeId</strong>
                        — @user.FirstName @user.LastName

                        <span class="ms-2">

                            @if (user.Status == "Active")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else if (user.Status == "Suspended")
                            {
                                <span class="badge bg-warning text-dark">
                                    Suspended
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @user.Status
                                </span>
                            }

                        </span>

                    </span>

                    <span>
                        @(expandedUserId == user.Id ? "▲" : "▼")
                    </span>

                </button>

                @if (expandedUserId == user.Id)
                {
                    <div class="border-top p-3">

                        <div class="row g-3">

                            <div class="col-md-4">
                                <strong>Employee ID</strong>
                                <div>@user.EmployeeId</div>
                            </div>

                            <div class="col-md-4">
                                <strong>Name</strong>
                                <div>
                                    @user.FirstName @user.LastName
                                </div>
                            </div>

                            <div class="col-md-4">
                                <strong>Email</strong>
                                <div>@user.Email</div>
                            </div>

                            <div class="col-md-4">
                                <strong>Role</strong>
                                <div>@user.Role</div>
                            </div>

                            <div class="col-md-4">
                                <strong>Status</strong>

                                <div>

                                    @if (user.Status == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (user.Status == "Suspended")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Suspended
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @user.Status
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>
}

@code {

    private CreateUserRequest newUser = new()
    {
        Role = 1
    };

    private string? message;

    private bool isSaving;

    private List<UserDto> users = new();

    private int? expandedUserId;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn || !AuthService.IsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        users = await ApiService.GetUsersAsync();
    }


    private void ToggleUser(int userId)
    {
        if (expandedUserId == userId)
        {
            expandedUserId = null;
        }
        else
        {
            expandedUserId = userId;
        }
    }


    private async Task AddUser()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(newUser.EmployeeId) ||
            string.IsNullOrWhiteSpace(newUser.FirstName) ||
            string.IsNullOrWhiteSpace(newUser.LastName) ||
            string.IsNullOrWhiteSpace(newUser.Email) ||
            string.IsNullOrWhiteSpace(newUser.Password))
        {
            message = "Please complete all fields.";
            return;
        }

        isSaving = true;

        try
        {
            var success = await ApiService.CreateUserAsync(newUser);

            if (success)
            {
                message = "User created successfully.";

                users = await ApiService.GetUsersAsync();

                newUser = new CreateUserRequest
                {
                    Role = 1
                };
            }
            else
            {
                message =
                    "User could not be created. Employee ID or email may already exist.";
            }
        }
        finally
        {
            isSaving = false;
        }
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/admin");
    }
}