
@page "/admin/drivers/{id:int}/documents"

@rendermode InteractiveServer

@using DriveLog.Web.Services
@using Microsoft.AspNetCore.Components.Forms

@inject DriveLogApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Admin - Driver Documents</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Driver Documents</h1>

    <a href="/admin/drivers" class="btn btn-outline-secondary">
        Back to Drivers
    </a>
</div>

@if (documents == null)
{
    <p>Loading documents...</p>
}
else
{
    <div class="card mb-4">
        <div class="card-body">

            <h5 class="card-title mb-3">Upload Driver Document</h5>

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Document Type</label>

                    <select class="form-select"
                            @bind="documentType">

                        <option value="License">Driver's Licence</option>
                        <option value="PrDP">PrDP</option>

                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Document File</label>

                    <InputFile OnChange="HandleFileSelected"
                               class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Issue Date</label>

                    <InputDate class="form-control"
                               @bind-Value="issueDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Expiry Date</label>

                    <InputDate class="form-control"
                               @bind-Value="expiryDate" />
                </div>

            </div>

            @if (!string.IsNullOrEmpty(uploadMessage))
            {
                <div class="alert alert-info mt-3">
                    @uploadMessage
                </div>
            }

            <button class="btn btn-primary mt-3"
                    @onclick="UploadDocument"
                    disabled="@isUploading">

                @(isUploading ? "Uploading..." : "Upload Document")

            </button>

        </div>
    </div>

    @if (documents.Count == 0)
    {
        <div class="alert alert-info">
            No documents found for this driver.
        </div>
    }
    else
    {
        <h5 class="mb-3">Documents</h5>

        <div class="d-flex flex-column gap-2">

            @foreach (var document in documents)
            {
                <div class="card">

                    <button type="button"
                            class="btn w-100 text-start d-flex justify-content-between align-items-center"
                            @onclick="() => ToggleDocument(document.Id)">

                        <span>
                            @document.DocumentType —
                            @document.FileName
                        </span>

                        <span>
                            @(expandedDocumentId == document.Id ? "▲" : "▼")
                        </span>

                    </button>

                    @if (expandedDocumentId == document.Id)
                    {
                        <div class="border-top p-3">

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <strong>Document Type</strong>
                                    <div>@document.DocumentType</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>Status</strong>
                                    <div>@document.DocumentStatus</div>
                                </div>

                                <div class="col-md-6">
                                    <strong>File</strong>
                                    <div>@document.FileName</div>
                                </div>

                                <div class="col-md-3">
                                    <strong>Issue Date</strong>
                                    <div>
                                        @document.IssueDate.ToShortDateString()
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <strong>Expiry Date</strong>
                                    <div>
                                        @document.ExpiryDate.ToShortDateString()
                                    </div>
                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>
    }
}

@code {

    [Parameter]
    public int id { get; set; }

    private List<DriverDocumentDto>? documents;

    private IBrowserFile? selectedFile;

    private string documentType = "License";

    private DateTime issueDate = DateTime.Today;

    private DateTime expiryDate = DateTime.Today.AddYears(1);

    private string? uploadMessage;

    private bool isUploading;

    private int? expandedDocumentId;

    private void ToggleDocument(int documentId)
    {
        if (expandedDocumentId == documentId)
        {
            expandedDocumentId = null;
        }
        else
        {
            expandedDocumentId = documentId;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadMessage = null;
    }

    private async Task UploadDocument()
    {
        if (selectedFile == null)
        {
            uploadMessage = "Please select a document file.";
            return;
        }

        if (expiryDate < issueDate)
        {
            uploadMessage = "Expiry date cannot be before issue date.";
            return;
        }

        isUploading = true;
        uploadMessage = null;

        try
        {
            var success = await ApiService.UploadDriverDocumentAsync(
                id,
                selectedFile,
                documentType,
                issueDate,
                expiryDate);

            if (success)
            {
                uploadMessage = "Document uploaded successfully.";

                selectedFile = null;

                documentType = "License";

                issueDate = DateTime.Today;

                expiryDate = DateTime.Today.AddYears(1);

                documents = await ApiService.GetDriverDocumentsAsync(id);
            }
            else
            {
                uploadMessage = "Document upload failed.";
            }
        }
        catch (Exception)
        {
            uploadMessage =
                "An error occurred while uploading the document.";
        }
        finally
        {
            isUploading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn || !AuthService.IsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        documents = await ApiService.GetDriverDocumentsAsync(id);
    }
}