@page "/driver/drive"

@rendermode InteractiveServer

@using DriveLog.Web.Services

@inject DriveLogApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Active Drive</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Active Drive</h1>

    <a href="/driver" class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>

@if (drive == null)
{
    <div class="alert alert-info">
        You do not currently have an active drive.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="card-title mb-4">
                Current Drive
            </h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <strong>Vehicle</strong>

                    <div>
                        @if (vehicles != null)
                        {
                            var vehicle = vehicles.FirstOrDefault(
                                v => v.Id == drive.VehicleId);

                            if (vehicle != null)
                            {
                                @($"{vehicle.RegistrationNumber} - {vehicle.Make} {vehicle.Model}")
                            }
                            else
                            {
                                @drive.VehicleId
                            }
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Customer</strong>
                    <div>@drive.Customer</div>
                </div>

                <div class="col-md-6">
                    <strong>Delivery Note ID</strong>
                    <div>@drive.DeliveryNoteId</div>
                </div>

                <div class="col-md-6">
                    <strong>Start Time</strong>
                    <div>@drive.StartTime</div>
                </div>

                <div class="col-md-6">
                    <strong>Start KM</strong>
                    <div>@drive.StartKm</div>
                </div>

                <div class="col-md-6">
                    <strong>Start Location</strong>
                    <div>@drive.StartLocation</div>
                </div>

                <div class="col-md-6">
                    <strong>Purpose</strong>
                    <div>@drive.Purpose</div>
                </div>

            </div>

            <hr class="my-4" />

            <h5 class="mb-3">
                End Drive
            </h5>

            <EditForm Model="endRequest"
                      OnValidSubmit="HandleEndDrive">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            End Location
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="endRequest.EndLocation" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            End KM
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="endRequest.EndKm" />
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-danger mt-3">
                    End Drive
                </button>

            </EditForm>

        </div>
    </div>
}

@if (!string.IsNullOrEmpty(endMessage))
{
    <div class="alert alert-success mt-3">
        @endMessage
    </div>

    <a href="/driver/start-drive"
       class="btn btn-primary">
        Start Another Drive
    </a>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info mt-3">
        @message
    </div>
}

@code {

    private DriveLogDto? drive;

    private List<VehicleDto>? vehicles;

    private string message = string.Empty;

    private string? endMessage;

    private EndDriveForm endRequest = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn || !AuthService.IsDriver)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var userId = AuthService.CurrentUser!.UserId;

        drive = await ApiService.GetActiveDriveAsync(userId);

        vehicles = await ApiService.GetVehiclesAsync();
    }

    private async Task HandleEndDrive()
    {
        if (drive == null)
            return;

        // Clear any previous error message.
        message = string.Empty;
        endMessage = null;

        var result = await ApiService.EndDriveAsync(
            drive.Id,
            endRequest.EndLocation,
            endRequest.EndKm);

        if (result == null)
        {
            message =
                "Unable to end the drive. Check that the End KM is valid.";

            return;
        }

        endMessage = "Drive ended successfully.";

        drive = null;
    }

    private class EndDriveForm
    {
        public string EndLocation { get; set; } = string.Empty;

        public int EndKm { get; set; }
    }
}