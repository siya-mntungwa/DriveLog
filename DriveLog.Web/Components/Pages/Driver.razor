@page "/driver"

@rendermode InteractiveServer

@using DriveLog.Web.Services

@inject DriveLogApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Driver Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Driver Dashboard</h1>

    <button class="btn btn-outline-danger"
            @onclick="Logout">
        Logout
    </button>
</div>

@if (currentDriver != null)
{
    <div class="card mb-4">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Welcome, @currentDriver.FirstName @currentDriver.LastName
            </h5>

            <div class="row g-3">

                <div class="col-md-4">
                    <strong>Employee ID</strong>
                    <div>@currentDriver.EmployeeId</div>
                </div>

                <div class="col-md-4">
                    <strong>Email</strong>
                    <div>@currentDriver.Email</div>
                </div>

                <div class="col-md-4">
                    <strong>Status</strong>
                    <div>@currentDriver.Status</div>
                </div>

            </div>

        </div>
    </div>
}

<div class="mb-4">

    <h5 class="mb-3">Driver Actions</h5>

    <div class="d-flex flex-wrap gap-2">

        <a href="/driver/start-drive"
           class="btn btn-primary">
            Start Drive
        </a>

        <a href="/driver/drive"
           class="btn btn-secondary">
            Active Drive
        </a>

        <a href="/driver/documents"
           class="btn btn-outline-secondary">
            My Documents
        </a>

        <a href="/driver/history"
           class="btn btn-outline-secondary">
            Drive History
        </a>

    </div>

</div>

@if (eligibility == null)
{
    <p>Checking driving eligibility...</p>
}
else if (eligibility.IsEligible)
{
    <div class="alert alert-success mb-4">

        <strong>Eligible to Drive</strong>

        <p class="mb-0">
            @eligibility.Message
        </p>

    </div>
}
else
{
    <div class="alert alert-danger mb-4">

        <strong>Not Eligible to Drive</strong>

        <p class="mb-0">
            @eligibility.Message
        </p>

    </div>
}

<h5 class="mb-3">Available Vehicles</h5>

@if (vehicles == null)
{
    <p>Loading vehicles...</p>
}
else
{
    var availableVehicles = vehicles
        .Where(v => v.Status == 0)
        .ToList();

    if (availableVehicles.Count == 0)
    {
        <div class="alert alert-info">
            No vehicles are currently available.
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">

            @foreach (var vehicle in availableVehicles)
            {
                <div class="card">

                    <button type="button"
                            class="btn w-100 text-start d-flex justify-content-between align-items-center"
                            @onclick="() => ToggleVehicle(vehicle.Id)">

                        <strong>
                            @vehicle.RegistrationNumber —
                            @vehicle.Make @vehicle.Model
                        </strong>

                        <span>
                            @(expandedVehicleId == vehicle.Id ? "▲" : "▼")
                        </span>

                    </button>

                    @if (expandedVehicleId == vehicle.Id)
                    {
                        <div class="border-top p-3">

                            <div class="row g-3">

                                <div class="col-md-4">
                                    <strong>Registration</strong>

                                    <div>
                                        @vehicle.RegistrationNumber
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Vehicle</strong>

                                    <div>
                                        @vehicle.Make @vehicle.Model
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Year</strong>

                                    <div>
                                        @vehicle.Year
                                    </div>
                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>
    }
}

@code {

    private List<DriverDto>? drivers;
    private List<VehicleDto>? vehicles;
    private DriverEligibilityDto? eligibility;
    private DriverDto? currentDriver;

    private int? expandedVehicleId;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn || !AuthService.IsDriver)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        drivers = await ApiService.GetDriversAsync();

        vehicles = await ApiService.GetVehiclesAsync();

        currentDriver = drivers.FirstOrDefault(
            d => d.Id == AuthService.CurrentUser!.UserId);

        if (currentDriver != null)
        {
            eligibility = await ApiService.GetDriverEligibilityAsync(
                currentDriver.Id);
        }
    }

    private void ToggleVehicle(int vehicleId)
    {
        if (expandedVehicleId == vehicleId)
            expandedVehicleId = null;
        else
            expandedVehicleId = vehicleId;
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}